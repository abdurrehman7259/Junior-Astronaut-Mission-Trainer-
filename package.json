{
  "name": "outpost-junior",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Outpost Junior: a kids' Moon outpost game driven by real NASA DONKI space-weather events (NASA Space Apps Challenge 2026).",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "fetch:donki": "tsx scripts/fetch-donki.ts",
    "fetch:radlab": "tsx scripts/fetch-radlab.ts",
    "fetch:osdr": "tsx scripts/fetch-osdr.ts",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.93.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
